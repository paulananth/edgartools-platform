                "field": "entity_name",
                "normalizer": "conformed",
                "token_list": "entity_legal_form",
                "min_count": 1
              }
            }
          ]
        },
        {
          "step": "5",
          "verdict": "deferred",
          "otherwise": true
        }
      ]
    }

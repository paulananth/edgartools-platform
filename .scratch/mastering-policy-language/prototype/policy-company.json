 },
 "rules": [
  {
   "rule_id": "company-tier-a-cik",
   "version": "2026-09-20",
   "family": "binding",
   "source": "sec.company",
   "note": "SEC CIK is authoritative for Company identity.",
   "emits": [
    "bind"
   ],
   "when": [
    {
     "primitive": "identifier_match@1",
     "args": {
      "namespace": "sec.cik",
      "field": "cik",
      "normalizer": "normalize_identifier@sec-cik-v1"
     }
    },
    {
     "primitive": "identifier_cardinality@1",
     "args": {
      "namespace": "sec.cik",
      "max_identities": 1
     }
    }
   ]
  },
  {
   "rule_id": "gleif-adjudicated-seed-link",
   "version": "2026-09-20",
   "family": "binding",
   "source": "gleif.golden_copy",
   "note": "GLEIF Company consumer spec: only revalidated Adjudicated Seed Links (308) publish.",
   "emits": [
    "bind"
   ],
   "when": [
    {
     "primitive": "evidence_present@1",
     "args": {
      "document": "gleif.adjudicated_seed_link.revalidated"
     }
    },
    {
     "primitive": "identifier_match@1",
     "args": {
      "namespace": "gleif.lei",
      "field": "lei",
      "normalizer": "normalize_identifier@lei-v1"
     }
    },
    {
     "primitive": "identifier_cardinality@1",
     "args": {
      "namespace": "gleif.lei",
      "max_identities": 1,
      "max_identifiers_per_identity": 1,
      "note": "one active binding per side"
     }
    }
   ]
  },
  {
   "rule_id": "gleif-deterministic-crosswalk",
   "version": "2026-09-20",
   "family": "binding",
   "source": "gleif.golden_copy",
   "note": "Verified deterministic crosswalk. Name match alone is never sufficient \u2014 a similarity-only binding rule is refused at registration.",
   "emits": [
    "bind"
   ],
   "when": [
    {
     "primitive": "identifier_match@1",
     "args": {
      "namespace": "gleif.lei",
      "field": "lei",
      "normalizer": "normalize_identifier@lei-v1"
     }
    },
    {
     "primitive": "evidence_present@1",
     "args": {
      "document": "gleif.crosswalk.verified"
     }
    }
   ]
  }
 ],

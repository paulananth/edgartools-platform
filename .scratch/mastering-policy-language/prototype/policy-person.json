  {
   "rule_id": "person-tier-a-owner-cik",
   "version": "2026-09-20",
   "family": "binding",
   "source": "sec.ownership_reporting_owner",
   "applies_to_verdict": "person",
   "note": "Ticket 02 Tier A. owner_cik is a cross-reference id; one id resolves to exactly one Person.",
   "emits": [
    "bind"
   ],
   "when": [
    {
     "primitive": "identifier_match@1",
     "args": {
      "namespace": "sec.cik",
      "field": "owner_cik",
      "normalizer": "normalize_identifier@sec-cik-v1"
     }
    },
    {
     "primitive": "identifier_cardinality@1",
     "args": {
      "namespace": "sec.cik",
      "max_identities": 1
     }
    }
   ]
  },
  {
   "rule_id": "person-tier-a-adv-ownerid",
   "version": "2026-09-20",
   "family": "binding",
   "source": "adv.schedule_a_b",
   "applies_to_verdict": "person",
   "note": "Ticket 02 Tier A. CRD individual record id; duplicate CRD records collapse onto one Person.",
   "emits": [
    "bind"
   ],
   "when": [
    {
     "primitive": "identifier_match@1",
     "args": {
      "namespace": "crd.individual",
      "field": "OwnerID",
      "normalizer": "normalize_identifier@crd-v1"
     }
    }
   ]
  },
  {
   "rule_id": "person-tier-b-issuer-name-role",
   "version": "2026-09-20",
   "family": "binding",
   "source": "*",
   "applies_to_verdict": "person",
   "note": "Ticket 02 Tier B compound context key. NO activation entry \u2014 calibration is Person ticket 17, still open. Fires as Steward review.",
   "emits": [
    "bind"
   ],
   "when": [
    {
     "primitive": "compound_key_equal@1",
     "args": {
      "components": [
       {
        "field": "issuer_or_firm_cik",
        "normalizer": "normalize_identifier@sec-cik-v1"
       },
       {
        "field": "person_name",
        "normalizer": "conformed"
       },
       {
        "field": "role_class"
       }
      ]
     }
    }
   ]
  },
  {
   "rule_id": "person-tier-c-fuzzy",
   "version": "2026-09-20",
   "family": "binding",
   "source": "*",
   "applies_to_verdict": "person",
   "note": "Ticket 02 Tier C. Never automatic: a binding rule may not decide on name similarity alone (statically refused at registration if it tried).",
   "emits": [
    "review"
   ],
   "when": [
    {
     "primitive": "compound_key_equal@1",
     "args": {
      "components": [
       {
        "field": "issuer_or_firm_cik",
        "normalizer": "normalize_identifier@sec-cik-v1"
       }
      ]
     }
    },
    {
     "primitive": "name_similarity@1",
     "args": {
      "left": "person_name",
      "right": "candidate_name",
      "method": "jaro_winkler@1",
      "min_score": 0.92,
      "normalizer": "conformed"
     }
    }
   ]
  }

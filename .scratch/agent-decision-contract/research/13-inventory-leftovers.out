SELECT 'is_person_of' AS probe, COUNT(*)::VARCHAR AS n1
FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_IS_PERSON_OF;
+-------------------+
| PROBE        | N1 |
|--------------+----|
| is_person_of | 0  |
+-------------------+

SELECT 'node_auditfirm' AS probe, COUNT(*)::VARCHAR AS n1
FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_NODE_AUDITFIRM;
+---------------------+
| PROBE          | N1 |
|----------------+----|
| node_auditfirm | 0  |
+---------------------+

SELECT 'dashboard_objs' AS probe, TABLE_NAME AS k1
FROM EDGARTOOLS_PROD.INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA IN ('EDGARTOOLS_DASHBOARD','MDM_GRAPH_REVIEW_DASHBOARD','EDGARTOOLS_DECISION','PUBLIC')
ORDER BY TABLE_SCHEMA, TABLE_NAME;
No data


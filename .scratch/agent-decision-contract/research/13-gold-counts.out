SELECT 'GRAPH_EDGE_IS_INSIDER' AS edge, COUNT(*) AS n FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_IS_INSIDER
UNION ALL SELECT 'GRAPH_EDGE_EMPLOYED_BY', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_EMPLOYED_BY
UNION ALL SELECT 'GRAPH_EDGE_INSTITUTIONAL_HOLDS', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_INSTITUTIONAL_HOLDS
UNION ALL SELECT 'GRAPH_EDGE_AUDITED_BY', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_AUDITED_BY
UNION ALL SELECT 'GRAPH_EDGE_HAS_PARENT_COMPANY', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_HAS_PARENT_COMPANY
UNION ALL SELECT 'GRAPH_EDGE_HOLDS', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_HOLDS
UNION ALL SELECT 'GRAPH_EDGE_COMPANY_HOLDS', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_COMPANY_HOLDS
UNION ALL SELECT 'GRAPH_EDGE_MANAGES_FUND', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_MANAGES_FUND
UNION ALL SELECT 'GRAPH_EDGE_ISSUED_BY', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_ISSUED_BY
UNION ALL SELECT 'GRAPH_EDGE_IS_ENTITY_OF', COUNT(*) FROM EDGARTOOLS_PROD.NEO4J_GRAPH_MIGRATION.GRAPH_EDGE_IS_ENTITY_OF
ORDER BY 1;

SELECT table_name, row_count
FROM (
  SELECT 'FINANCIAL_FACTORS' AS table_name, COUNT(*) AS row_count FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.FINANCIAL_FACTORS
  UNION ALL SELECT 'FINANCIAL_DERIVED', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.FINANCIAL_DERIVED
  UNION ALL SELECT 'FINANCIAL_FACTS', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.FINANCIAL_FACTS
  UNION ALL SELECT 'ACCOUNTING_FLAGS', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.ACCOUNTING_FLAGS
  UNION ALL SELECT 'EARNINGS_RELEASES', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.EARNINGS_RELEASES
  UNION ALL SELECT 'EARNINGS_CALENDAR', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.EARNINGS_CALENDAR
  UNION ALL SELECT 'CONSENSUS_ESTIMATES', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.CONSENSUS_ESTIMATES
  UNION ALL SELECT 'GUIDANCE_FACTS', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.GUIDANCE_FACTS
  UNION ALL SELECT 'TRANSCRIPT_EVENTS', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.TRANSCRIPT_EVENTS
  UNION ALL SELECT 'EXECUTIVE_RECORDS', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.EXECUTIVE_RECORDS
  UNION ALL SELECT 'OWNERSHIP_HOLDINGS', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.OWNERSHIP_HOLDINGS
  UNION ALL SELECT 'OWNERSHIP_ACTIVITY', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.OWNERSHIP_ACTIVITY
  UNION ALL SELECT 'INSTITUTIONAL_HOLDINGS', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.INSTITUTIONAL_HOLDINGS
  UNION ALL SELECT 'FILING_ACTIVITY', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.FILING_ACTIVITY
  UNION ALL SELECT 'FILING_DETAIL', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.FILING_DETAIL
  UNION ALL SELECT 'ADVISER_DISCLOSURES', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.ADVISER_DISCLOSURES
  UNION ALL SELECT 'ADVISER_OFFICES', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.ADVISER_OFFICES
  UNION ALL SELECT 'PRIVATE_FUNDS', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.PRIVATE_FUNDS
  UNION ALL SELECT 'TICKER_REFERENCE', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.TICKER_REFERENCE
  UNION ALL SELECT 'MDM_COMPANY', COUNT(*) FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.MDM_COMPANY
)
ORDER BY table_name;

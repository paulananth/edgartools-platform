{
  "Comment": "Run an EdgarTools MDM workflow on ECS Fargate with an optional numeric limit override.",
  "StartAt": "HasLimitOverride",
  "States": {
    "HasLimitOverride": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.limit",
              "IsPresent": true
            },
            {
              "Variable": "$.limit",
              "IsNumeric": true
            }
          ],
          "Next": "RunMdmTaskWithLimit"
        }
      ],
      "Default": "RunMdmTaskDefault"
    },
    "RunMdmTaskDefault": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-medium:149",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'run', '--entity-type', 'all', '--limit', '100')"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "BackoffRate": 2.0,
          "MaxAttempts": 2
        }
      ],
      "End": true
    },
    "RunMdmTaskWithLimit": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-medium:149",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'run', '--entity-type', 'all', '--limit', States.Format('{}', $.limit))"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "BackoffRate": 2.0,
          "MaxAttempts": 2
        }
      ],
      "End": true
    }
  }
}


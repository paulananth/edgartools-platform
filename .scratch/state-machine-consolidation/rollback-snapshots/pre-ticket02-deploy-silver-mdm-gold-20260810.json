{
  "Comment": "Re-process pipeline for already-loaded bronze: (0) seed universe (enrol any bootstrap_pending CIKs), (1) seed batch file from silver DuckDB (no SEC downloads), (2) parallel bootstrap-batch uses bronze SHA256 cache for submissions + runs artifact pipeline, (3) MDM entity resolution + Neo4j sync, (4) gold build + Snowflake export manifest. Trigger with: {} or {\"tracking_status_filter\": \"active|bootstrap_pending\"}",
  "StartAt": "SeedUniverse",
  "States": {
    "SeedUniverse": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-large:169",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('seed-universe', '--run-id', $$.Execution.Name)"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "SeedSilverBatches"
    },
    "SeedSilverBatches": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-medium:177",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('seed-silver-batches', '--run-id', $$.Execution.Name, '--tracking-status-filter', $.tracking_status_filter)"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "BatchSilver"
    },
    "BatchSilver": {
      "Type": "Map",
      "MaxConcurrency": 3,
      "Comment": "Re-process silver + artifacts from cached bronze. Submissions not re-downloaded.",
      "ToleratedFailurePercentage": 0,
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSONL",
          "MaxItems": 100000
        },
        "Parameters": {
          "Bucket": "edgartools-prod-bronze-690839588395",
          "Key.$": "States.Format('warehouse/bronze/reference/cik_universe/runs/{}/cik_batches.jsonl', $$.Execution.Name)"
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "RunBatch",
        "States": {
          "RunBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
              "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-medium:177",
              "PropagateTags": "TASK_DEFINITION",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "AssignPublicIp": "ENABLED",
                  "SecurityGroups": [
                    "sg-0f7de61f13ba27744"
                  ],
                  "Subnets": [
                    "subnet-09dfb6a34597e8ed3",
                    "subnet-0606a828b86737ac6"
                  ]
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "edgar-warehouse",
                    "Command.$": "States.Array('bootstrap-batch', '--cik-list', $.cik_list, '--artifact-policy', 'skip', '--parser-policy', 'skip', '--run-id', $$.Execution.Name)"
                  }
                ]
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 120,
                "BackoffRate": 2.0,
                "MaxAttempts": 3
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Next": "MdmRun"
    },
    "MdmRun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-medium:149",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'run', '--entity-type', 'all')"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "MdmBackfill"
    },
    "MdmBackfill": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-medium:149",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'backfill-relationships')"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "MdmExport"
    },
    "MdmExport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-medium:149",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'export')"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "MdmSync"
    },
    "MdmSync": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-medium:149",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'sync-graph')"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "MdmVerify"
    },
    "MdmVerify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-small:149",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'verify-graph')"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "GoldRefresh",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "GoldRefresh"
        }
      ]
    },
    "GoldRefresh": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-large:169",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('gold-refresh', '--run-id', $$.Execution.Name)"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "End": true
    }
  }
}


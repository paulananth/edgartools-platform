{
  "Comment": "Handoff residual pipeline: security nodes + IS_INSIDER + HOLDS + COMPANY_HOLDS + INSTITUTIONAL_HOLDS into MDM and Snowflake graph. Does not re-resolve companies. Does not claim Ticket 20 GO. Heavy stages use mdm-large (8 GiB) after prod MdmSecurities OOM on 2 GiB.",
  "StartAt": "MdmSecurities",
  "States": {
    "MdmSecurities": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-large:83",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'run', '--entity-type', 'security')"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "BackoffRate": 2.0,
          "MaxAttempts": 2
        }
      ],
      "Next": "MdmPersons"
    },

                    "subnet-09dfb6a34597e8ed3",
                    "subnet-0606a828b86737ac6"
                  ]
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "edgar-warehouse",
                    "Command.$": "States.Array('bootstrap-batch', '--cik-list', $.cik_list, '--artifact-policy', 'skip', '--parser-policy', 'skip', '--run-id', $$.Execution.Name, '--resume-ledger-run-id', $.resume_from_run_id)"
                  }
                ]
              }

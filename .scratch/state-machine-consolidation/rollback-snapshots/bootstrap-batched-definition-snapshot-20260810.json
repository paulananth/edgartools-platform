{
  "Comment": "Seed CIK universe then bootstrap companies in parallel batches of 100.",
  "StartAt": "SeedUniverse",
  "States": {
    "SeedUniverse": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-medium:177",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('seed-universe', '--run-id', $$.Execution.Name)"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 60,
          "BackoffRate": 2.0,
          "MaxAttempts": 2
        }
      ],
      "Next": "BatchBootstrap"
    },
    "BatchBootstrap": {
      "Type": "Map",
      "MaxConcurrency": 3,
      "ToleratedFailurePercentage": 10,
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "JSONL",
          "MaxItems": 100000
        },
        "Parameters": {
          "Bucket": "edgartools-prod-bronze-690839588395",
          "Key.$": "States.Format('warehouse/bronze/reference/cik_universe/runs/{}/cik_batches.jsonl', $$.Execution.Name)"
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "RunBatch",
        "States": {
          "RunBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
              "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-medium:177",
              "PropagateTags": "TASK_DEFINITION",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "AssignPublicIp": "ENABLED",
                  "SecurityGroups": [
                    "sg-0f7de61f13ba27744"
                  ],
                  "Subnets": [
                    "subnet-09dfb6a34597e8ed3",
                    "subnet-0606a828b86737ac6"
                  ]
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "edgar-warehouse",
                    "Command.$": "States.Array('bootstrap-batch', '--cik-list', $.cik_list, '--run-id', $$.Execution.Name)"
                  }
                ]
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.TaskFailed"
                ],
                "IntervalSeconds": 120,
                "BackoffRate": 2.0,
                "MaxAttempts": 2
              }
            ],
            "End": true
          }
        }
      },
      "End": true
    }
  }
}


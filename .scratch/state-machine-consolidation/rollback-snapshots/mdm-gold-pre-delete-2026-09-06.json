{
  "Comment": "MDM entity resolution + Neo4j sync + gold-refresh. No silver batch step \u2014 run after bronze+silver are complete.",
  "StartAt": "Mastering",
  "States": {
    "Mastering": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "arn:aws:ecs:us-east-1:690839588395:cluster/edgartools-prod-warehouse",
        "TaskDefinition": "arn:aws:ecs:us-east-1:690839588395:task-definition/edgartools-prod-mdm-medium:219",
        "PropagateTags": "TASK_DEFINITION",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": [
              "sg-0f7de61f13ba27744"
            ],
            "Subnets": [
              "subnet-09dfb6a34597e8ed3",
              "subnet-0606a828b86737ac6"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "edgar-warehouse",
              "Command.$": "States.Array('mdm', 'mastering', '--entity-type', 'all', '--limit', '100', '--run-id', $$.Execution.Name)"
            }
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 120,
          "BackoffRate": 2.0,
          "MaxAttempts": 2
        }
      ],
      "Next": "Infer Relationships"
    },
    "Infer Relationships": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",

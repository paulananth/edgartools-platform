SELECT
    'derived_sample' AS probe,
    CIK,
    ACCESSION_NUMBER,
    FISCAL_YEAR,
    FISCAL_PERIOD,
    PERIOD_END,
    EBITDA,
    EPS_DILUTED,
    EBITDA_MARGIN,
    ROE,
    ROA
FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.FINANCIAL_DERIVED
WHERE EBITDA IS NOT NULL
   OR EPS_DILUTED IS NOT NULL
   OR EBITDA_MARGIN IS NOT NULL
ORDER BY PERIOD_END DESC
LIMIT 8;

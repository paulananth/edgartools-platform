SELECT
    'dt_refresh' AS probe,
    NAME,
    SCHEMA_NAME,
    TARGET_LAG,
    REFRESH_MODE,
    LAST_SUCCESSFUL_REFRESH_TIME,
    LAST_COMPLETED_REFRESH_TIME,
    DATA_TIMESTAMP
FROM TABLE(EDGARTOOLS_PROD.INFORMATION_SCHEMA.DYNAMIC_TABLES())
WHERE SCHEMA_NAME = 'EDGARTOOLS_GOLD'
  AND NAME IN ('FINANCIAL_FACTORS', 'FINANCIAL_DERIVED')
ORDER BY NAME;

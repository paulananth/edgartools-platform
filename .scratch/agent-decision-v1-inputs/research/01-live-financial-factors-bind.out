SELECT
    'factors_any_live_key' AS probe,
    COUNT(*) AS n,
    COUNT_IF(
        REVENUE IS NOT NULL
        OR GROSS_PROFIT IS NOT NULL
        OR EBIT IS NOT NULL
        OR NET_INCOME IS NOT NULL
        OR TOTAL_ASSETS IS NOT NULL
        OR TOTAL_LIABILITIES IS NOT NULL
        OR TOTAL_EQUITY IS NOT NULL
        OR CASH_AND_EQUIVALENTS IS NOT NULL
        OR TOTAL_DEBT IS NOT NULL
        OR OPERATING_CASH_FLOW IS NOT NULL
        OR FREE_CASH_FLOW IS NOT NULL
        OR GROSS_MARGIN IS NOT NULL
        OR NET_MARGIN IS NOT NULL
        OR RETURN_ON_EQUITY IS NOT NULL
        OR RETURN_ON_ASSETS IS NOT NULL
        OR ROIC IS NOT NULL
    ) AS any_of_16_live_keys
FROM EDGARTOOLS_PROD.EDGARTOOLS_GOLD.FINANCIAL_FACTORS;

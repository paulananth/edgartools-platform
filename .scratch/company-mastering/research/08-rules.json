{
  "_about": "Ticket 08: the two SEC-to-GLEIF matching rules as frozen for measurement (2026-09-25). They enter the Company policy unchanged. The name, jurisdiction and postal tests are edgar_warehouse/mdm/clean/names.py; the measurement reproduces them through that module (08-coverage.py, output sha256 3b51d0ac...5e1f698).",
  "rules": [
    {
      "rule_id": "sec-gleif-name-jurisdiction",
      "version": "2026-09-25.1",
      "family": "name_binding",
      "source": "gleif.level1.v1",
      "holder_source": "sec.submissions.company.v1",
      "applies_to_verdict": "company",
      "emits": ["bind"],
      "on_no_match": "wait",
      "when": [
        {"primitive": "name_census_match@1", "args": {"sec_normalizer": "normalize_text@sec-legal-form-kept-v1", "gleif_normalizer": "normalize_text@legal-form-kept-v1"}},
        {"primitive": "gleif_entity_eligible@1", "args": {"categories": ["GENERAL"], "entity_statuses": ["ACTIVE"], "refused_registration_statuses": ["ANNULLED", "DUPLICATE"]}},
        {"primitive": "holds_no_other_lei@1", "args": {}},
        {"primitive": "jurisdiction_agrees@1", "args": {"sec_field": "state_of_incorporation", "sec_codes": "edgar-iso-v1", "gleif_field": "jurisdiction"}}
      ]
    },
    {
      "rule_id": "sec-gleif-name-postal",
      "version": "2026-09-25.1",
      "family": "name_binding",
      "source": "gleif.level1.v1",
      "holder_source": "sec.submissions.company.v1",
      "applies_to_verdict": "company",
      "emits": ["bind"],
      "on_no_match": "wait",
      "when": [
        {"primitive": "name_census_match@1", "args": {"sec_normalizer": "normalize_text@sec-legal-form-kept-v1", "gleif_normalizer": "normalize_text@legal-form-kept-v1"}},
        {"primitive": "gleif_entity_eligible@1", "args": {"categories": ["GENERAL"], "entity_statuses": ["ACTIVE"], "refused_registration_statuses": ["ANNULLED", "DUPLICATE"]}},
        {"primitive": "holds_no_other_lei@1", "args": {}},
        {"primitive": "postal_agrees@1", "args": {"sec_code": "matching.business_postal_code", "sec_country": "matching.business_country", "gleif_code": "matching.headquarters_postal_code", "gleif_country": "matching.headquarters_country"}}
      ]
    }
  ],
  "name_census": {
    "version": "sec-gleif-name-census-v1",
    "sec_names": "current and former names of every SEC filer in the capture",
    "gleif_names": "legal and other names of every GLEIF record in the publication, branches excluded",
    "match": "the SEC filer's current name key equals the GLEIF legal name key",
    "unique": "exactly one SEC filer and exactly one GLEIF legal entity carry the key"
  }
}

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
pip-wheel-metadata/
.pytest_cache/
.testmondata*
.mypy_cache/
.ruff_cache/
*.pyo
.coverage
.coverage.*
coverage.xml
htmlcov/

# Terraform — never commit real variable values
*.tfvars
!*.tfvars.example
terraform.tfstate
terraform.tfstate.*
*.tfplan
infra/terraform/**/tfplan
.terraform/
.terraform.lock.hcl
infra/terraform/**/backend.hcl
!infra/terraform/**/backend.hcl.example

# Environment files
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.pfx
*.p12
rsa_key*

# Docker
*.tar

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temp files
.tmp/

# AI agent tooling (the shared review agents are tracked; the rest stays local)
.claude/*
!.claude/agents/
.codex

# Local go-live wizard state and sanitized reports
.edgartools-go-live/
infra/aws-*-application.json
infra/aws-*-application.json.bak-*
infra/aws-*-image-ref.txt
.gstack/

# Agent worktrees
.worktrees/

# Local Terraform state backups (may contain secrets) — never commit
infra/.aws-tfstate-backups/
infra/.s3-staging-cleanup-evidence/
infra/.warehouse-duplicate-reclaim-evidence/
infra/.bronze-historic-review-manifests/
infra/.bronze-historic-delete-evidence/

# Local agent tool output: diagram/HTML artifacts and ratchet state. These are
# working files an agent produces locally; the checked record is the repo.
.archify/
.lavish/
.omp/ratchet/
eval/

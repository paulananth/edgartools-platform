# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyo
.coverage
.coverage.*
coverage.xml
htmlcov/

# Terraform — never commit real variable values
*.tfvars
!*.tfvars.example
terraform.tfstate
terraform.tfstate.*
*.tfplan
infra/terraform/**/tfplan
.terraform/
.terraform.lock.hcl
infra/terraform/**/backend.hcl
!infra/terraform/**/backend.hcl.example

# Generated-environment configs carry Snowflake account identifiers, which this
# repo never commits. Only the template is tracked.
infra/terraform/environments/*.json
!infra/terraform/environments/*.json.example

# dbt profiles contain Snowflake credentials
infra/snowflake/dbt/**/profiles.yml
!infra/snowflake/dbt/**/profiles.yml.example
infra/snowflake/dbt/**/.user.yml
infra/snowflake/dbt/**/logs/
infra/snowflake/dbt/**/target/

# Environment files
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.pfx
*.p12
rsa_key*

# Docker
*.tar

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temp files
.tmp/

# AI agent tooling
.claude/
.codex

# Local go-live wizard state and sanitized reports
.edgartools-go-live/
infra/aws-*-application.json
infra/aws-*-image-ref.txt
infra/snowflake/sql/*_native_pull_handshake.json
.gstack/

# Agent worktrees
.worktrees/

# Local Terraform state backups (may contain secrets) — never commit
infra/.aws-tfstate-backups/

# GH-247: local dashboard-release evidence artifacts (deploy.sh) — secret-free
# but not meant to be version-controlled; the live record is the JSON PUT to
# the Snowflake stage alongside each release.
infra/snowflake/streamlit/.evidence/

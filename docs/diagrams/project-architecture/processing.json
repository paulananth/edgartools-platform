  "cards": [
    {
      "dot": "cyan",
      "title": "Rules drive the same engine",
      "items": [
        "Source contracts declare formats, columns, quality and mapping. Readers make no provider requests.",
        "Source Extract tables feed mastering preparation and silver workers; source-specific targets declare their ordering."
      ]
    },
    {
      "dot": "emerald",
      "title": "Identity and evidence",
      "items": [
        "Mastering decides kind, searches identifiers, applies activated name rules, then selects fields and relationships.",
        "Automatic preparation runs before scoped reads where configured; actual name binding follows identifier matching."
      ]
    },
    {
      "dot": "amber",
      "title": "Scope of this map",
      "items": [
        "Current committed main; code/configuration architecture, not live deployment or source readiness.",
        "Company, Person, Security and fund-related domains share the engine. Domain coverage and activation vary by source.",
        "Continue with work-control.html for governance and serving.html for deployment and publishing."
      ]
    }
  ]

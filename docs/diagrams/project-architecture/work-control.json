  "cards": [
    {
      "dot": "violet",
      "title": "Control does no data work",
      "items": [
        "Bookkeeping issues task envelopes. Workers execute; separate verifier processes inspect the reported output.",
        "Destination transactions enforce their own authoritative constraints and live fencing."
      ]
    },
    {
      "dot": "amber",
      "title": "Governance is a sequence of gates",
      "items": [
        "Profiling, data quality, onboarding, refining rules and data operations skills govern configuration and evidence.",
        "Approval, qualification, activation and production execution are separate claims. A diagram grants none of them."
      ]
    },
    {
      "dot": "cyan",
      "title": "Replay and recovery",
      "items": [
        "A run pins rules, inputs and runtime; leases and immutable receipts support bounded retry.",
        "The loader finishes eligible open runs, performs configured preparation, derives scope and freezes new work."
      ]
    }
  ]

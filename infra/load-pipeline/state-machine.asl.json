{
  "Comment": "A load. Before any step, the loader refuses a load in which a step would wait for what cannot come. With `steps`, readiness then those steps in order, the first failure ending it. Without, readiness then every lane of the load jobs file at once, each lane's steps in order, each step holding until the steps it needs (in any lane) are done; a lane that fails is caught so the other lanes go on, a step that needs its failed step stops, and the load fails at the end if any lane failed. Then, when asked, the load's finish. The loader names the lanes and steps; this file names none. With `steps` and `inlanes`, only those steps run, each in its lane, the lanes at once (a forced load restarts what is left without repeating what is done). Input: {\"steps\": [<name>, ...] (optional), \"inlanes\": true (optional, with steps), \"plan\": false, \"finish\": false}.",
  "StartAt": "Readiness",
  "States": {
    "Readiness": {
      "Type": "Task",
      "Resource": "${activity}",
      "Parameters": {
        "action": "readiness"
      },
      "HeartbeatSeconds": 300,
      "TimeoutSeconds": 1800,
      "ResultPath": null,
      "Next": "Mode"
    },
    "Mode": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.steps",
              "IsPresent": true
            },
            {
              "Variable": "$.inlanes",
              "IsPresent": true
            }
          ],
          "Next": "Lanes named"
        },
        {
          "Variable": "$.steps",
          "IsPresent": true,
          "Next": "Begin"
        }
      ],
      "Default": "Lanes"
    },
    "Begin": {
      "Type": "Task",
      "Resource": "${activity}",
      "HeartbeatSeconds": 300,
      "TimeoutSeconds": 600,
      "Parameters": {
        "action": "begin",
        "steps.$": "$.steps",
        "plan.$": "$.plan",
        "force.$": "$.force"
      },
      "ResultPath": null,
      "Next": "Start"
    },
    "Lanes": {
      "Type": "Task",
      "Resource": "${activity}",
      "HeartbeatSeconds": 300,
      "Parameters": {
        "action": "lanes",
        "plan.$": "$.plan",
        "force.$": "$.force"
      },
      "TimeoutSeconds": 600,
      "ResultSelector": {
        "names.$": "$.lanes"
      },
      "ResultPath": "$.lanes",
      "Next": "Run lanes"
    },
    "Lanes named": {
      "Type": "Task",
      "Resource": "${activity}",
      "HeartbeatSeconds": 300,
      "Parameters": {
        "action": "lanes",
        "plan.$": "$.plan",
        "force.$": "$.force",
        "steps.$": "$.steps"
      },
      "TimeoutSeconds": 600,
      "ResultSelector": {
        "names.$": "$.lanes"
      },
      "ResultPath": "$.lanes",
      "Next": "Run lanes"
    },
    "Run lanes": {
      "Type": "Map",
      "ItemsPath": "$.lanes.names",
      "MaxConcurrency": 1,
      "Parameters": {
        "lane.$": "$$.Map.Item.Value",
        "plan.$": "$.plan",
        "force.$": "$.force"
      },
      "Iterator": {
        "StartAt": "Lane",
        "States": {
          "Lane": {
            "Type": "Task",
            "Resource": "${activity}",
            "HeartbeatSeconds": 300,
            "Parameters": {
              "action": "lane",
              "lane.$": "$.lane",
              "plan.$": "$.plan",
              "force.$": "$.force"
            },
            "TimeoutSeconds": 604800,
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": null,
                "Next": "Lane failed"
              }
            ],
            "Next": "Lane done"
          },
          "Lane done": {
            "Type": "Pass",
            "Parameters": {
              "lane.$": "$.lane",
              "failed": false
            },
            "End": true
          },
          "Lane failed": {
            "Type": "Pass",
            "Parameters": {
              "lane.$": "$.lane",
              "failed": true
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.results",
      "Next": "Count"
    },
    "Count": {
      "Type": "Pass",
      "Parameters": {
        "failed.$": "States.ArrayContains($.results[*].failed, true)",
        "finish.$": "$.finish"
      },
      "Next": "Lanes ended"
    },
    "Lanes ended": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.failed",
          "BooleanEquals": true,
          "Next": "A lane failed"
        }
      ],
      "Default": "Finish?"
    },
    "A lane failed": {
      "Type": "Fail",
      "Error": "LaneFailed",
      "Cause": "a lane failed: its steps and the steps that needed them stopped; the run's state file names each"
    },
    "Start": {
      "Type": "Pass",
      "Parameters": {
        "steps.$": "$.steps",
        "plan.$": "$.plan",
        "force.$": "$.force",
        "count.$": "States.ArrayLength($.steps)",
        "next": 0,
        "finish.$": "$.finish"
      },
      "Next": "More"
    },
    "More": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.next",
          "NumericLessThanPath": "$.count",
          "Next": "Step"
        }
      ],
      "Default": "Finish?"
    },
    "Step": {
      "Type": "Task",
      "Resource": "${activity}",
      "Parameters": {
        "action": "step",
        "step.$": "States.ArrayGetItem($.steps, $.next)",
        "plan.$": "$.plan",
        "force.$": "$.force"
      },
      "HeartbeatSeconds": 300,
      "TimeoutSeconds": 172800,
      "ResultPath": null,
      "Next": "Advance"
    },
    "Advance": {
      "Type": "Pass",
      "Parameters": {
        "steps.$": "$.steps",
        "plan.$": "$.plan",
        "force.$": "$.force",
        "count.$": "$.count",
        "next.$": "States.MathAdd($.next, 1)",
        "finish.$": "$.finish"
      },
      "Next": "More"
    },
    "Finish?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.finish",
          "BooleanEquals": true,
          "Next": "Finish"
        }
      ],
      "Default": "Done"
    },
    "Finish": {
      "Type": "Task",
      "Resource": "${activity}",
      "Parameters": {
        "action": "finish"
      },
      "HeartbeatSeconds": 300,
      "TimeoutSeconds": 86400,
      "ResultPath": null,
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}

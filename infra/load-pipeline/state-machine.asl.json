{
  "Comment": "A load. Before any step, the loader refuses a load in which a step would wait for what cannot come. With `steps`, readiness then those steps in order, the first failure ending it. Without, readiness then every lane of the chain file at once, each lane's steps in order, each step holding until the steps it needs (in any lane) are done; a lane that fails is caught so the other lanes go on, a step that needs its failed step stops, and the load fails at the end if any lane failed. Then, when asked, the chain's finish. The loader names the lanes and steps; this file names none. Input: {\"steps\": [<name>, ...] (optional), \"plan\": false, \"finish\": false}.",
  "StartAt": "Readiness",
  "States": {
    "Readiness": {
      "Type": "Task",
      "Resource": "${activity}",
      "Parameters": {
        "action": "readiness"
      },
      "HeartbeatSeconds": 300,
      "TimeoutSeconds": 1800,
      "ResultPath": null,
      "Next": "Mode"
    },
    "Mode": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.steps",
          "IsPresent": true,
          "Next": "Begin"
        }
      ],
      "Default": "Lanes"
    },
    "Begin": {
      "Type": "Task",
      "Resource": "${activity}",
      "HeartbeatSeconds": 300,
      "TimeoutSeconds": 600,
      "Parameters": {
        "action": "begin",
        "steps.$": "$.steps",
        "plan.$": "$.plan"
      },
      "ResultPath": null,
      "Next": "Start"
    },
    "Lanes": {
      "Type": "Task",
      "Resource": "${activity}",
      "HeartbeatSeconds": 300,
      "Parameters": {
        "action": "lanes",
        "plan.$": "$.plan"
      },
      "TimeoutSeconds": 600,
      "ResultSelector": {
        "names.$": "$.lanes"
      },
      "ResultPath": "$.lanes",
      "Next": "Run lanes"
    },
    "Run lanes": {
      "Type": "Map",
      "ItemsPath": "$.lanes.names",
      "MaxConcurrency": 0,
      "Parameters": {
        "lane.$": "$$.Map.Item.Value",
        "plan.$": "$.plan"
      },
      "Iterator": {
        "StartAt": "Lane",
        "States": {
          "Lane": {
            "Type": "Task",
            "Resource": "${activity}",
            "HeartbeatSeconds": 300,
            "Parameters": {
              "action": "lane",
              "lane.$": "$.lane",
              "plan.$": "$.plan"
            },
            "TimeoutSeconds": 604800,
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": null,
                "Next": "Lane failed"
              }
            ],
            "Next": "Lane done"
          },
          "Lane done": {
            "Type": "Pass",
            "Parameters": {
              "lane.$": "$.lane",
              "failed": false
            },
            "End": true
          },
          "Lane failed": {
            "Type": "Pass",
            "Parameters": {
              "lane.$": "$.lane",
              "failed": true
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.results",
      "Next": "Count"
    },
    "Count": {
      "Type": "Pass",
      "Parameters": {
        "failed.$": "States.ArrayContains($.results[*].failed, true)",
        "finish.$": "$.finish"
      },
      "Next": "Lanes ended"
    },
    "Lanes ended": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.failed",
          "BooleanEquals": true,
          "Next": "A lane failed"
        }
      ],
      "Default": "Finish?"
    },
    "A lane failed": {
      "Type": "Fail",
      "Error": "LaneFailed",
      "Cause": "a lane failed: its steps and the steps that needed them stopped; the chain's state file names each"
    },
    "Start": {
      "Type": "Pass",
      "Parameters": {
        "steps.$": "$.steps",
        "plan.$": "$.plan",
        "count.$": "States.ArrayLength($.steps)",
        "next": 0,
        "finish.$": "$.finish"
      },
      "Next": "More"
    },
    "More": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.next",
          "NumericLessThanPath": "$.count",
          "Next": "Step"
        }
      ],
      "Default": "Finish?"
    },
    "Step": {
      "Type": "Task",
      "Resource": "${activity}",
      "Parameters": {
        "action": "step",
        "step.$": "States.ArrayGetItem($.steps, $.next)",
        "plan.$": "$.plan"
      },
      "HeartbeatSeconds": 300,
      "TimeoutSeconds": 172800,
      "ResultPath": null,
      "Next": "Advance"
    },
    "Advance": {
      "Type": "Pass",
      "Parameters": {
        "steps.$": "$.steps",
        "plan.$": "$.plan",
        "count.$": "$.count",
        "next.$": "States.MathAdd($.next, 1)",
        "finish.$": "$.finish"
      },
      "Next": "More"
    },
    "Finish?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.finish",
          "BooleanEquals": true,
          "Next": "Finish"
        }
      ],
      "Default": "Done"
    },
    "Finish": {
      "Type": "Task",
      "Resource": "${activity}",
      "Parameters": {
        "action": "finish"
      },
      "HeartbeatSeconds": 300,
      "TimeoutSeconds": 86400,
      "ResultPath": null,
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}

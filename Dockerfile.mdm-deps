# The configured source engine (mastering to-do 15): build its Python wheel
# with the Rust toolchain, then install the wheel below. The toolchain stays
# in this stage; the image gets only the wheel.
FROM public.ecr.aws/docker/library/rust:1-slim-bookworm AS rust
FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm AS engine
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:${PATH}
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY --from=rust /usr/local/cargo /usr/local/cargo
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir "maturin>=1.7,<2"
COPY crates/source-contract /src/source-contract
RUN maturin build --release --locked --compatibility linux \
    --manifest-path /src/source-contract/Cargo.toml --out /wheels

FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV UV_COMPILE_BYTECODE=0
ENV UV_LINK_MODE=copy
ENV UV_NO_CACHE=1
ENV UV_PROJECT_ENVIRONMENT=/opt/edgartools-venv
ENV VIRTUAL_ENV=/opt/edgartools-venv
ENV PATH="/opt/edgartools-venv/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade --no-cache-dir pip uv

COPY pyproject.toml uv.lock README.md /app/

RUN uv sync --frozen --no-dev --extra s3 --extra mdm-runtime --no-install-project --no-install-package source-contract \
    && uv cache clean

COPY --from=engine /wheels /wheels
RUN uv pip install --no-deps /wheels/*.whl && rm -rf /wheels
